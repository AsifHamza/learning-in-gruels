# Capstone Code — .gitignore
#
# Deliberately NOT ignored:
#   *.ipynb          notebooks are committed WITH their outputs, so they read without running
#   requirements.txt one per phase, pinned, shared by that phase's steps
#   *.py             the jupytext plain-text pair of each notebook

# ---- virtualenvs (one per phase: 01-environment/.venv, 02-exact-solver/.venv, ...) ----
.venv/
venv/
env/
ENV/
pip-wheel-metadata/

# ---- Python bytecode / build junk ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
.jupyter/
.virtual_documents/
profile_default/
ipython_config.py

# ---- training artefacts (folders 03-05: MAPPO runs, checkpoints, logs) ----
# Run IDs look like A2-n10-circle-gat-s0 — the outputs are large and reproducible from seed.
runs/
outputs/
checkpoints/
wandb/
tensorboard/
lightning_logs/
mlruns/
*.pt
*.pth
*.ckpt
*.pkl
*.npy
*.npz
*.h5

# ---- large or regenerable media ----
*.mp4
*.gif
frames/

# ---- caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- editors and tooling ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---- secrets / local config ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- trained models ARE part of the record ----
# Every training step saves its models to <step>/models/ as a state_dict (.pt) and a record (.json).
# They are small (about 15 to 25 KB each) and are committed, so results can be re-analysed from the
# exact models that produced them. The general *.pt rule above still applies everywhere else.
!0[1-4]-*/step*/models/
!0[1-4]-*/step*/models/*.pt
!0[1-4]-*/step*/models/*.json
